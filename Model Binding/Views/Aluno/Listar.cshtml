@model List<Model_binding.Models.Aluno>

@{
    ViewData["Title"] = "Alunos Cadastrados";
}

<div class="container mt-4">
    <h2>Alunos Cadastrados</h2>
    <hr />

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    <p>
        <a asp-action="Cadastrar" class="btn btn-primary">Cadastrar Novo Aluno</a>
    </p>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>RA</th>
                <th>Curso</th>
                <th>Data de Nascimento</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Nenhum aluno cadastrado ainda.</td>
                </tr>
            }
            else
            {
                foreach (var aluno in Model)
                {
                    <tr>
                        <td>@aluno.Nome</td>
                        <td>@aluno.Email</td>
                        <td>@aluno.RA</td>
                        <td>@aluno.Curso</td>
                        <td>@aluno.DataNascimento.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>